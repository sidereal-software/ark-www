---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Records from "../components/Records.astro";
import Standards from "../components/Standards.astro";
import Different from "../components/Different.astro";
import Pricing from "../components/Pricing.astro";
import NeverBlock from "../components/NeverBlock.astro";
import DataTrust from "../components/DataTrust.astro";
import ContactCta from "../components/ContactCta.astro";
import Sources from "../components/Sources.astro";
import PhotoBand from "../components/PhotoBand.astro";
---

{
  /* One page, in the order someone actually decides in: what is this, why does
    it exist, how does it work, what does it hold, does it satisfy my auditor,
    why you and not them, what does it cost, what will you refuse to do to me,
    whose data is it, and how do I reach a human. */
}
<BaseLayout>
  <Hero />
  <Problem />
  {
    /* The bands sit at the two places the page changes subject. The first
      closes the argument about the problem and puts a face to who has it,
      before the product appears. The second lands after the record list,
      where the page turns from what ARK stores to what it will and will not
      do - and a measurement being taken by hand is the whole point of that
      list. */
  }
  <PhotoBand
    slug="keeper-and-elephant"
    position="50% 32%"
    caption="A keeper and an elephant at the Maryland Zoo. Most of what is worth recording happens here, not at a desk."
  />
  <HowItWorks />
  <Records />
  <PhotoBand
    slug="wing-measurement"
    position="50% 45%"
    caption="A wing measured with a ruler, the way most of these numbers still get taken."
  />
  <Standards />
  <Different />
  <Pricing />
  <NeverBlock />
  <DataTrust />
  <ContactCta />
  <Sources />
</BaseLayout>
