---

{
  /* One page, in the order someone actually decides in: what is this, why does
    it exist, how does it work, what does it hold, does it satisfy my auditor,
    why you and not them, what does it cost, what will you refuse to do to me,
    whose data is it, and how do I reach a human. */
}
<BaseLayout>
  <Hero />
  <Problem />
  <HowItWorks />
  <Records />
  <Standards />
  <Different />
  <Pricing />
  <NeverBlock />
  <DataTrust />
  <ContactCta />
  <Sources />
