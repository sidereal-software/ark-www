---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Different from "../components/Different.astro";
import NextPages from "../components/NextPages.astro";
import ContactCta from "../components/ContactCta.astro";
---

{
  /* Home carries the whole argument and nothing a reader would go looking for
    on purpose: what this is, why it exists, how it works, and why it is built
    the way it is. What it records and what it costs are the two things people
    arrive already meaning to check, so they get their own URLs - see the top
    of src/data/nav.ts for the measurement that decided the split. */
}
<BaseLayout structuredData>
  <Hero />
  <Problem />
  <HowItWorks />
  <Different />
  <NextPages
    links={[
      {
        href: "/what-it-records",
        label: "What it records",
        blurb:
          "Twelve groups of record, from the daily log to medical and welfare checks, and what the accrediting bodies expect of each.",
      },
      {
        href: "/pricing",
        label: "Pricing",
        blurb:
          "Four plans, priced on animals rather than people, and the things we are committing never to charge you for.",
      },
    ]}
  />
  <ContactCta />
</BaseLayout>
