---
import Section from "./Section.astro";
import { SOURCES } from "../data/sources";
---

<Section
  id="sources"
  eyebrow="Sources"
  title="Where the claims on this page come from."
  lead="Everything above that is a statement about the world rather than about ARK is numbered and listed here."
  width="prose"
>
  <ol class="mt-12 space-y-6">
    {
      SOURCES.map((source, i) => (
        <li id={`source-${source.id}`} class="grid scroll-mt-24 grid-cols-[1.75rem_1fr] gap-2">
          <span class="text-sm font-semibold text-primary tabular-nums">{i + 1}.</span>
          <div>
            <p class="text-sm text-pretty text-muted-foreground">{source.text}</p>
            {/* A bare DOI is one unbreakable 36-character token, and the 1fr
              track is sized by it: without a break opportunity the list pushes
              the whole document 11px wider than a 320px viewport. `anywhere`
              rather than `break-word` because only `anywhere` counts towards
              the min-content size the track is measured against. */}
            {source.href && (
              <p class="mt-1.5">
                <a
                  href={source.href}
                  rel="noopener nofollow"
                  class="rounded text-sm font-medium wrap-anywhere text-primary underline underline-offset-4 hover:no-underline"
                >
                  {source.href.replace(/^https?:\/\//, "")}
                </a>
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <p class="mt-10 border-t border-border pt-6 text-sm text-muted-foreground">
    Sources without a link are cited by name, section and date. Where a phrase appears in quotation
    marks, the words inside them are the source's.
  </p>
</Section>
