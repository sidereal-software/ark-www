---
import Logo from "./Logo.astro";
import { CONTACT_HREF, SITE } from "../consts";
import { PHOTOS } from "../data/photos";

// Only the licences that oblige us. CC0 and the public-domain release do not,
// and listing them here would pad the credit line with names the licence did
// not ask us to print, which makes the ones it did ask for easier to miss.
const credited = PHOTOS.filter((p) => p.attributionRequired);

const year = new Date().getFullYear();

// Root-relative, not bare fragments: this footer also renders on /404, and a
// bare "#pricing" there resolves against the missing path and goes nowhere.
const columns = [
  {
    heading: "The page",
    links: [
      { href: "/#problem", label: "The problem" },
      { href: "/#how", label: "How it works" },
      { href: "/#records", label: "What it records" },
      { href: "/#standards", label: "Standards and compliance" },
    ],
  },
  {
    heading: "Deciding",
    links: [
      { href: "/#different", label: "Where ARK is different" },
      { href: "/#pricing", label: "Pricing" },
      { href: "/#never", label: "What we will never do" },
      { href: "/#sources", label: "Sources" },
    ],
  },
];
---

<footer class="border-t border-border bg-background px-5 py-14 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <Logo />
        <p class="mt-4 max-w-sm text-sm text-muted-foreground">
          Mobile-first animal recordkeeping for zoos, wildlife rehabilitation centres, sanctuaries
          and rescues. Built by Sidereal Software.
        </p>
        <a
          href={CONTACT_HREF}
          class="mt-4 inline-block rounded text-sm font-medium text-primary underline underline-offset-4 hover:no-underline"
        >
          {SITE.contactEmail}
        </a>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <h2 class="text-sm font-semibold">{column.heading}</h2>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="rounded text-sm text-muted-foreground transition-colors hover:text-foreground"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    {
      /* Attribution is a licence condition, not a courtesy, so it renders in
        the page rather than living in a repository file nobody visiting the
        site can read. Each entry carries the author, the licence and a link to
        the original, which is what CC BY and CC BY-SA ask for.

        None of these photographs shows an ARK customer, and none is captioned
        as though it did - see the header of src/data/photos.ts. */
    }
    <div class="mt-12 border-t border-border pt-7 text-sm text-muted-foreground">
      <h2 class="text-sm font-semibold text-foreground">Photography</h2>
      <p class="mt-3 max-w-3xl">
        Photographs on this page are used under open licences and show working animal-care and
        field-research settings. They do not depict ARK customers.
      </p>
      <ul class="mt-3 max-w-3xl space-y-1.5">
        {
          credited.map((p) => (
            <li>
              <a
                href={p.href}
                class="rounded underline underline-offset-4 hover:text-foreground hover:no-underline"
                rel="noopener"
              >
                <cite class="not-italic">{p.title}</cite>
              </a>
              {" by "}
              {p.credit}
              {", "}
              <a
                href={p.licenseHref}
                class="rounded underline underline-offset-4 hover:text-foreground hover:no-underline"
                rel="license noopener"
              >
                {p.license}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-8">&copy; {year} Sidereal Software. All rights reserved.</p>
    </div>
  </div>
</footer>
