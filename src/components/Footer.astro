---
import Logo from "./Logo.astro";
import { CONTACT_HREF, SITE } from "../consts";

const year = new Date().getFullYear();

// Grouped by page rather than by theme, so the footer doubles as the site map
// it became when one page turned into four. Every href is absolute from the
// root: this footer renders on /404 too, and a bare "#pricing" there resolves
// against the missing path and goes nowhere.
const columns = [
  {
    heading: "Start here",
    links: [
      { href: "/#problem", label: "The problem" },
      { href: "/#how", label: "How it works" },
      { href: "/#different", label: "Design decisions" },
    ],
  },
  {
    heading: "What it records",
    links: [
      { href: "/what-it-records", label: "Everything it records" },
      { href: "/what-it-records#standards", label: "Standards and compliance" },
    ],
  },
  {
    heading: "Pricing",
    links: [
      { href: "/pricing", label: "Plans" },
      { href: "/pricing#never", label: "What we will never do" },
      { href: "/pricing#trust", label: "Your records" },
      { href: "/sources", label: "Sources" },
    ],
  },
];
---

<footer class="border-t border-border bg-background px-5 py-14 sm:px-8">
  <div class="mx-auto max-w-6xl">
    {
      /* Five tracks, not four: the identity block keeps its two and the three
      link groups take one each. */
    }
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <Logo />
        {
          /* The motto sits with the mark here, which is the one place on the
          site it reads as a signature rather than as a heading. */
        }
        <p class="mt-3 font-display text-base font-semibold text-foreground">{SITE.motto}</p>
        <p class="mt-3 max-w-sm text-sm text-muted-foreground">
          Mobile-first animal recordkeeping for zoos, wildlife rehabilitation centres, sanctuaries
          and rescues. Built by Sidereal Software.
        </p>
        <a
          href={CONTACT_HREF}
          class="mt-4 inline-block rounded text-sm font-medium text-primary underline underline-offset-4 hover:no-underline"
        >
          {SITE.contactEmail}
        </a>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <h2 class="text-sm font-semibold">{column.heading}</h2>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="rounded text-sm text-muted-foreground transition-colors hover:text-foreground"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-12 border-t border-border pt-7 text-sm text-muted-foreground">
      <p>&copy; {year} Sidereal Software. All rights reserved.</p>
    </div>
  </div>
</footer>
