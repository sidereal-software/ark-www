---
interface Props {
  /** Renders the mark on its own, for tight spaces. */
  markOnly?: boolean;
  class?: string;
}

const { markOnly = false, class: className = "" } = Astro.props;
---

{
  /* An arch on a groundline: an enclosure doorway and a hull, depending on how
    you look at it. No paw prints. The mark is decorative here because the
    wordmark beside it carries the name, so it is hidden from assistive tech. */
}
<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-6 shrink-0 text-primary"
    aria-hidden="true"
  >
    <path d="M5 20.5V11a7 7 0 0 1 14 0v9.5"></path>
    <path d="M2.5 20.5h19"></path>
    <circle cx="12" cy="12.5" r="1.75" fill="currentColor" stroke="none"></circle>
  </svg>
  {
    !markOnly && (
      <span class="font-display text-xl leading-none font-semibold tracking-wide">ARK</span>
    )
  }
</span>
