---
interface Props {
  /** Renders the mark on its own, for tight spaces. */
  markOnly?: boolean;
  class?: string;
}

const { markOnly = false, class: className = "" } = Astro.props;
---

{
  /* The ARK app's own mark, copied unchanged from the product's
    frontend/public/favicon.svg: four toes and a pad. Two things differ from the
    file it came from, and neither touches the geometry. The viewBox is cropped
    to the paw's own bounds rather than the app icon's 64-unit square, so a
    square box renders the paw at full width instead of floating it in padding;
    and the fill is currentColor rather than the app's hardcoded #556A4D, so one
    mark serves both colour schemes. Decorative here because the wordmark beside
    it carries the name, so it is hidden from assistive tech. */
}
<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    viewBox="3 13 58 40"
    fill="currentColor"
    class="size-6 shrink-0 text-primary"
    aria-hidden="true"
  >
    <ellipse cx="20" cy="22" rx="6" ry="8"></ellipse>
    <ellipse cx="44" cy="22" rx="6" ry="8"></ellipse>
    <ellipse cx="9" cy="34" rx="5" ry="7"></ellipse>
    <ellipse cx="55" cy="34" rx="5" ry="7"></ellipse>
    <path d="M32 30c8 0 15 6 15 13 0 6-5 9-15 9s-15-3-15-9c0-7 7-13 15-13z"></path>
  </svg>
  {
    !markOnly && (
      <span class="font-display text-xl leading-none font-semibold tracking-wide">ARK</span>
    )
  }
</span>
