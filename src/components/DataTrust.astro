---
import Section from "./Section.astro";

/*
 * Nobody reading this page is technical. They are keepers, rehabilitators,
 * sanctuary managers and volunteers, and they are deciding whether this
 * software will make their week easier.
 *
 * This section used to answer a question none of them asked. It described
 * request-level membership resolution, a second enforcement net in the
 * database, mutation audit rows, API tokens and backup units that could
 * otherwise drift apart. Every one of those was true and every one of them
 * was the implementation of a promise rather than the promise.
 *
 * The rule now: say what the reader gets, in the words they would use. If a
 * sentence would only reassure someone who already knows what a row is, it is
 * answering the wrong question. The engineering still has to be there - it
 * just is not what sells it.
 */
const points = [
  {
    title: "Only your people can see your animals",
    body: "Your records belong to your organization and stop there. Nobody at another facility can see them, search them or come across them by accident.",
  },
  {
    title: "You can always tell who wrote what",
    body: "Every entry and every change carries a name and a time. If a weight looks wrong six months later, you can see who recorded it, when, and what it said before somebody edited it.",
  },
  {
    title: "Nothing quietly disappears",
    body: "A record someone removes can still be accounted for. If an inspector asks what happened to an animal you had last year, the answer is there.",
  },
  {
    title: "Your photos stay with the records they belong to",
    body: "A photo is part of the entry it was taken for, not a separate gallery you have to keep in step. You will not end up with a note describing a wound and no picture of it.",
  },
  {
    title: "You can take everything with you",
    body: "Download every animal and every log you have written, as a spreadsheet, whenever you want. That keeps working if your trial ends or you move to a cheaper plan. If you ever leave ARK, you leave with your records.",
  },
  {
    title: "We do not sell your records",
    body: "Not to anyone, for any purpose, and not to sell advertising against. The subscription is how ARK makes money.",
  },
];
---

<Section
  id="trust"
  tone="muted"
  eyebrow="Your records"
  title="Whose they are, and who can see them."
>
  <div class="mt-14 grid gap-x-10 gap-y-9 md:grid-cols-2 lg:grid-cols-3">
    {
      points.map((point) => (
        <div class="reveal">
          <h3 class="text-lg">{point.title}</h3>
          <p class="mt-2.5 text-muted-foreground">{point.body}</p>
        </div>
      ))
    }
  </div>
</Section>
