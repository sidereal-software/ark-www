---
import Section from "./Section.astro";

const points = [
  {
    title: "Your organization is the boundary",
    body: "Every request resolves your membership before it touches a row. Another organization's animal comes back as not found rather than as forbidden, because as far as your session is concerned it does not exist. The database enforces the same rule underneath as a second net.",
  },
  {
    title: "Every change is attributable",
    body: "Mutations write an audit row - who, what, when, and the values before and after. Auditing is not a paid feature.",
  },
  {
    title: "Leaving is a supported operation",
    body: "Export keeps working after a trial lapses or a downgrade. Pro adds API tokens if you would rather pull the data programmatically.",
  },
  {
    title: "Photos and records back up together",
    body: "An image without its record is unreachable and a record without its image is a broken page, so the files and the database are treated as one backup unit rather than two schedules that can drift apart.",
  },
  {
    title: "No advertising, no data resale",
    body: "Your records are not sold, aggregated for resale, or used to target advertising. The subscription is the business model.",
  },
];
---

<Section
  id="trust"
  tone="muted"
  eyebrow="Your data"
  title="Where your records live, and who can reach them."
>
  <div class="mt-14 grid gap-x-10 gap-y-9 md:grid-cols-2 lg:grid-cols-3">
    {
      points.map((point) => (
        <div class="reveal">
          <h3 class="text-lg">{point.title}</h3>
          <p class="mt-2.5 text-muted-foreground">{point.body}</p>
        </div>
      ))
    }
  </div>
</Section>
