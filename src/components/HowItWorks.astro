---
import Section from "./Section.astro";

/*
 * The steps used to carry a stopwatch - 0s, 8s, 15s, 30s - which reads as a
 * measurement and was not one. Nobody timed a keeper. They are numbered now.
 * The loop is still short, and the copy is allowed to say the loop is short;
 * it is not allowed to put a figure on it that no one has measured.
 */
const steps = [
  {
    at: "01",
    title: "Find the animal",
    body: "Search by name, microchip, band, case number or enclosure. Or open the enclosure in front of you and pick from who lives there.",
  },
  {
    at: "02",
    title: "Tap a category",
    body: "Categories your organization defines. Feeding, behaviour, treatment, enrichment - whatever your team already says out loud.",
  },
  {
    at: "03",
    title: "Write the sentence, take the photo",
    body: "One line is a complete record. The photo comes straight from the camera. If you write it up an hour later, you can still say when it actually happened.",
  },
  {
    at: "04",
    title: "Save",
    body: "It is in the permanent record, attributed to you, searchable, and visible to whoever walks in next. Nobody types it up again.",
  },
];
---

<Section
  id="how"
  eyebrow="How it works"
  title="One capture, start to finish."
  lead="ARK is built around a single loop, and every other feature hangs off it."
>
  <ol
    class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2"
  >
    {
      steps.map((step) => (
        <li class="reveal bg-card p-7 sm:p-8">
          <p class="eyebrow" aria-hidden="true">
            {step.at}
          </p>
          <h3 class="mt-3 text-xl">{step.title}</h3>
          <p class="mt-2.5 text-muted-foreground">{step.body}</p>
        </li>
      ))
    }
  </ol>

  {
    /* SCREENSHOT SEAM - an entry saved with no signal.
      A phone-shaped shot of an animal profile in airplane mode, the just-saved
      log carrying its pending-sync marker. It belongs on the right of this
      panel; restore the two-column grid when it lands:
        grid items-center lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-14
      Capture brief in SCREENSHOTS.md. */
  }
  <div class="reveal mt-8 rounded-2xl border border-border bg-muted/60 p-7 sm:p-10">
    <div class="max-w-2xl">
      <p class="eyebrow">Offline</p>
      <h3 class="mt-3 text-2xl text-balance">Capture does not wait for a connection.</h3>
      <div class="mt-4 space-y-4 text-muted-foreground">
        <p>
          Back of the property, inside a barn, in a quarantine room, or on the afternoon the site's
          internet is simply down. The work carries on either way.
        </p>
        <p>
          A note, a photo, a weight or a feeding saves on your phone straight away, and uploads
          itself the moment you are back in range. You do not have to remember to do anything, and
          tapping save twice on a bad signal will not leave you with the same entry recorded twice.
        </p>
      </div>
    </div>
  </div>
</Section>
