---
import Section from "./Section.astro";
import ScreenshotPlaceholder from "./ScreenshotPlaceholder.astro";

const steps = [
  {
    at: "0s",
    title: "Find the animal",
    body: "Search by name, microchip, band, case number or enclosure. Or open the enclosure in front of you and pick from who lives there.",
  },
  {
    at: "8s",
    title: "Tap a category",
    body: "Categories your organization defines. Feeding, behaviour, treatment, enrichment - whatever your team already says out loud.",
  },
  {
    at: "15s",
    title: "Write the sentence, take the photo",
    body: "One line is a complete record. The photo comes straight from the camera. What you observed and when you observed it are stored separately from when you typed it.",
  },
  {
    at: "30s",
    title: "Save",
    body: "It is in the permanent record, attributed to you, searchable, and visible to whoever walks in next. Nobody types it up again.",
  },
];
---

<Section
  id="how"
  eyebrow="How it works"
  title="One capture, start to finish."
  lead="ARK is built around a single loop, and every other feature hangs off it."
>
  <ol
    class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2"
  >
    {
      steps.map((step) => (
        <li class="reveal bg-card p-7 sm:p-8">
          <p class="eyebrow" aria-hidden="true">
            {step.at}
          </p>
          <h3 class="mt-3 text-xl">{step.title}</h3>
          <p class="mt-2.5 text-muted-foreground">{step.body}</p>
        </li>
      ))
    }
  </ol>

  <div
    class="reveal mt-8 grid items-center gap-10 rounded-2xl border border-border bg-muted/60 p-7 sm:p-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-14"
  >
    <div>
      <p class="eyebrow">Offline</p>
      <h3 class="mt-3 text-2xl text-balance">Capture does not wait for a connection.</h3>
      <div class="mt-4 space-y-4 text-muted-foreground">
        <p>
          Facilities report the ordinary kind of outage: the site's internet goes down for an
          afternoon and the work carries on regardless. ARK treats the network as optional rather
          than assumed.
        </p>
        <p>
          A note, a photo, a weight or a feeding is written on the device and queued. When a
          connection returns it syncs, and because every capture carries an id the device generated,
          a retry is acknowledged as the entry you already made rather than filed as a second one.
        </p>
      </div>
    </div>

    <ScreenshotPlaceholder
      class="justify-self-center lg:justify-self-end"
      label="Captured offline, waiting to sync"
      shot="An animal profile in airplane mode with a just-saved log carrying the pending-sync chip, and the offline indicator visible in the app chrome."
      viewport="390 x 844, light mode, airplane mode on"
      frame="phone"
    />
  </div>
</Section>
