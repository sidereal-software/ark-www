---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { photo } from "../data/photos";

/**
 * The one way a photograph gets onto this site.
 *
 * It exists so three things cannot drift apart: the file in
 * src/assets/photos/, the licence and credit in src/data/photos.ts, and the
 * alt text. Asking for a slug that is not in the data file throws at build
 * time, the same way <Footnote /> throws on an unknown citation id - an
 * unattributed CC BY-SA photograph is a licence breach, not a cosmetic bug,
 * so it should never survive to a deploy.
 *
 * Framing is done with object-position rather than by cropping the source.
 * See the ShareAlike note at the top of src/data/photos.ts for why that
 * distinction matters for four of the six files.
 */
interface Props {
  slug: string;
  /** Tailwind classes for the wrapper. Aspect ratio belongs here. */
  class?: string;
  /** CSS object-position, to choose what survives the frame. */
  position?: string;
  /** Only the hero photograph should be eager; everything else is below the fold. */
  eager?: boolean;
  /** Rendered width hint for the srcset. */
  widths?: number[];
  sizes?: string;
}

const {
  slug,
  class: className = "",
  position = "center",
  eager = false,
  widths = [640, 960, 1280, 1600, 2000],
  sizes = "(min-width: 1024px) 50vw, 100vw",
} = Astro.props;

const meta = photo(slug);

// Astro needs a static glob to resolve local images; a bare dynamic import()
// of a runtime string would not be traced into the build.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp}",
  {
    eager: true,
  },
);
const entry = files[`../assets/photos/${slug}.jpg`];
if (!entry) {
  throw new Error(
    `No image file at src/assets/photos/${slug}.jpg, but "${slug}" is declared in src/data/photos.ts.`,
  );
}
---

{
  /* No `relative` in the base class, deliberately. Tailwind emits `absolute`
    and `relative` into the same layer, so a caller passing `absolute` does not
    reliably beat a hardcoded `relative` here - which class wins is decided by
    the order the utilities happen to land in the stylesheet, not by the order
    they appear in this attribute. The closing CTA needs the figure absolutely
    positioned behind its own text, so positioning is the caller's to set. */
}
<figure class={`overflow-hidden ${className}`}>
  <Image
    src={entry.default}
    alt={meta.alt}
    widths={widths}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding={eager ? "sync" : "async"}
    class="h-full w-full object-cover"
    style={`object-position: ${position}`}
  />
  <slot />
</figure>
