---
import Section from "./Section.astro";
import { RECORD_GROUPS } from "../data/records";
---

<Section
  id="records"
  tone="muted"
  eyebrow="What it records"
  title={`${RECORD_GROUPS.length} groups of record.`}
  lead="Everything below is in ARK today, not on a roadmap. Where something needs a particular plan, the card says which one."
>
  {
    /* SCREENSHOT SEAM - an animal's page, at desk width.
      Who the animal is, where it came from, how its weight has moved, and
      everything written about it lately. Landscape, 16:9, above the card grid.
      Capture brief in SCREENSHOTS.md; drop an <Image> here.

      The marked placeholders that used to stand in for the three shots are
      gone. They were honest about the gap, but they were also the only visual
      on the site, which meant a visitor's strongest impression of the product
      was three dashed rectangles apologising for themselves. An absence reads
      better than an advertised absence. */
  }

  <ul class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {
      RECORD_GROUPS.map((group, i) => (
        <li class="reveal flex flex-col rounded-2xl border border-border bg-card p-7 shadow-sm">
          <div class="flex items-baseline justify-between gap-4">
            <span class="eyebrow" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            {group.tier && (
              <span class="rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-accent-foreground">
                {group.tier === "Standard" ? "Standard and up" : "Pro and up"}
              </span>
            )}
          </div>

          <h3 class="mt-3 text-xl">{group.title}</h3>
          <p class="mt-2 text-sm text-muted-foreground">{group.blurb}</p>

          <ul class="mt-5 space-y-2 border-t border-border pt-5 text-sm">
            {group.items.map((item) => (
              <li class="grid grid-cols-[0.75rem_1fr] gap-2.5">
                <span class="mt-2.5 h-px bg-primary" aria-hidden="true" />
                <span class="text-pretty">{item}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</Section>
