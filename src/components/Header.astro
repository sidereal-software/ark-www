---
import Logo from "./Logo.astro";
import MobileNav from "./MobileNav";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { BAR_LINKS } from "@/data/nav";
import { CONTACT_HREF } from "../consts";
---

{
  /* Two navigations, one set of links, and only ever one of them on screen.
    At md and up the four bar links sit inline. Below it they do not fit, so
    the menu takes over and carries every section rather than the four - see
    src/data/nav.ts for why the split is where it is.

    MobileNav is the only hydrated thing on this site, and it is client:load
    rather than client:visible or client:idle because a navigation control in a
    sticky header is on screen from the first frame and has to work when it is
    touched, not when the browser gets round to it. */
}
<header
  class="sticky top-0 z-40 border-b border-border/70 bg-background/85 backdrop-blur-md supports-[backdrop-filter]:bg-background/70"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-5 sm:gap-6 sm:px-8"
  >
    <a
      href="/"
      class="rounded-md text-foreground transition-opacity hover:opacity-80"
      aria-label="ARK home"
    >
      <Logo />
    </a>

    <ul class="ml-auto hidden items-center gap-7 md:flex">
      {
        BAR_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-md text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a href={CONTACT_HREF} class={cn(buttonVariants({ size: "xl" }), "ml-auto md:ml-0")}>
      Get in touch
    </a>

    <MobileNav client:load />
  </nav>
</header>
