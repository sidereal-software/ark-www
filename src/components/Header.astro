---
import Logo from "./Logo.astro";
import { CONTACT_HREF } from "../consts";

// Root-relative, not bare fragments. This header also renders on /404, where a
// bare "#pricing" would resolve against the missing path and leave the visitor
// exactly where they were.
const links = [
  { href: "/#problem", label: "The problem" },
  { href: "/#how", label: "How it works" },
  { href: "/#records", label: "What it records" },
  { href: "/#pricing", label: "Pricing" },
];
---

{
  /* No hamburger. Below md the section links give way to the one action that
    matters, which is cheaper than a menu that needs a script to open. */
}
<header
  class="sticky top-0 z-40 border-b border-border/70 bg-background/85 backdrop-blur-md supports-[backdrop-filter]:bg-background/70"
>
  <nav aria-label="Primary" class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5 sm:px-8">
    <a
      href="/"
      class="rounded-md text-foreground transition-opacity hover:opacity-80"
      aria-label="ARK home"
    >
      <Logo />
    </a>

    <ul class="ml-auto hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-md text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={CONTACT_HREF}
      class="ml-auto rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-sm transition-[transform,box-shadow] hover:shadow-md active:translate-y-px md:ml-0"
    >
      Get in touch
    </a>
  </nav>
</header>
