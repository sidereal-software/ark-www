---
interface Props {
  id?: string;
  /** Small tracked label above the heading. Rendered as a <p>, never a heading. */
  eyebrow?: string;
  title?: string;
  /** One or two sentences under the heading. */
  lead?: string;
  /** `ink` is the dark band; it flips the whole colour set beneath it. */
  tone?: "base" | "muted" | "ink";
  /** `prose` caps at a readable measure; `wide` gives grids their room. */
  width?: "prose" | "wide";
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  lead,
  tone = "base",
  width = "wide",
  class: className = "",
} = Astro.props;

// `muted` is the full sand, not a fraction of it. At 60% over the cream
// background the band was nearly the same colour as the section above it,
// which is how a warm palette ends up reading as grey - and the contrast
// figures published in theme.css are measured against full --muted, so
// blending it here would quietly make that table wrong.
const toneClass = {
  base: "bg-background text-foreground",
  muted: "bg-muted text-foreground",
  ink: "on-ink bg-ink text-ink-foreground",
}[tone];

const widthClass = width === "prose" ? "max-w-3xl" : "max-w-6xl";
const leadClass = tone === "ink" ? "text-ink-muted" : "text-muted-foreground";
---

{
  /* The fragment id sits on the content, not on the <section>.
    A section carries 128px of top padding at lg, so an anchor pointed at the
    section box scrolled its *padding* to just under the header and left 135px
    of empty space before the eyebrow appeared - measured, not guessed. The
    section still lands correctly by that reading, and it still looked broken,
    because what a reader is aiming at is the heading rather than the box.
    Targeting the inner container scrolls the padding off and puts the eyebrow
    where the section box used to be.

    The <section> keeps aria-labelledby, so moving the id costs it nothing: it
    is labelled by its own heading, and the id was only ever a link target. */
}
<section
  class={`px-5 py-20 sm:px-8 sm:py-24 lg:py-32 ${toneClass} ${className}`}
  aria-labelledby={id && title ? `${id}-heading` : undefined}
>
  <div id={id} class={`mx-auto ${widthClass}`}>
    {
      (eyebrow || title || lead) && (
        <header class="reveal max-w-3xl">
          {eyebrow && (
            <>
              <p class="eyebrow">{eyebrow}</p>
              <div class="rule mt-3 mb-6 w-24" />
            </>
          )}
          {title && (
            <h2 id={id ? `${id}-heading` : undefined} class="text-3xl text-balance sm:text-4xl">
              {title}
            </h2>
          )}
          {lead && <p class={`mt-5 text-lg text-pretty ${leadClass}`}>{lead}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
