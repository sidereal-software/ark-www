---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { PLANS, PLAN_CONSTANTS } from "../data/pricing";
import { CONTACT_HREF } from "../consts";
---

<Section
  id="pricing"
  eyebrow="Pricing"
  title="One number per tier. No per-user fee on any of them."
  lead="Two things are metered: how many animals are in your care right now, and how much space your photos and files take. Nothing else."
>
  <ul class="reveal mt-10 flex flex-wrap gap-x-6 gap-y-3">
    {
      PLAN_CONSTANTS.map((item) => (
        <li class="flex items-center gap-2 text-sm font-medium">
          <Icon name="check" class="size-4 shrink-0 text-primary" />
          {item}
        </li>
      ))
    }
  </ul>

  <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
    {
      PLANS.map((plan, i) => (
        <article
          class={`reveal flex flex-col rounded-2xl border bg-card p-7 ${
            plan.featured
              ? "border-primary shadow-lg ring-1 ring-primary"
              : "border-border shadow-sm"
          }`}
        >
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-xl">{plan.name}</h3>
            {plan.featured && (
              <span class="rounded-full bg-primary px-2.5 py-1 text-xs font-semibold text-primary-foreground">
                Most facilities
              </span>
            )}
          </div>

          <p class="mt-2 min-h-12 text-sm text-muted-foreground">{plan.audience}</p>

          <p class="mt-5 flex min-h-12 items-baseline gap-2">
            <span class="font-display text-4xl font-semibold">{plan.price}</span>
            {plan.cadence && <span class="text-sm text-muted-foreground">{plan.cadence}</span>}
          </p>

          <dl class="mt-6 space-y-2 border-y border-border py-5 text-sm">
            <div class="flex gap-2">
              <dt class="sr-only">Animal capacity</dt>
              <dd class="font-medium">{plan.animals}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="sr-only">Storage</dt>
              <dd class="font-medium">{plan.storage}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="sr-only">Users</dt>
              <dd class="font-medium text-primary">Unlimited users</dd>
            </div>
          </dl>

          {/* min-h holds the four cards' feature lists on one line as this
              label wraps at some widths and not others. */}
          <p class="mt-5 min-h-8 text-xs font-semibold tracking-wide text-muted-foreground uppercase">
            {i === 0 ? "Includes" : `Everything in ${PLANS[i - 1]!.name}, plus`}
          </p>

          <ul class="mt-3 grow space-y-2.5 text-sm">
            {plan.adds.map((add) => (
              <li class="grid grid-cols-[1rem_1fr] gap-2">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-primary" />
                <span class="text-pretty">{add}</span>
              </li>
            ))}
          </ul>

          <a
            href={CONTACT_HREF}
            class={`mt-7 rounded-xl px-4 py-3 text-center text-sm font-semibold transition-[transform,box-shadow,background-color] active:translate-y-px ${
              plan.featured
                ? "bg-primary text-primary-foreground shadow-md hover:shadow-lg"
                : "border border-border bg-card text-foreground hover:bg-muted"
            }`}
          >
            {plan.id === "enterprise" ? `Talk to us about ${plan.name}` : `Ask about ${plan.name}`}
          </a>
        </article>
      ))
    }
  </div>

  <div class="mt-8 grid gap-5 md:grid-cols-2">
    <div class="reveal rounded-2xl border border-border bg-card p-7">
      <h3 class="text-lg">Active animals, not animals ever recorded</h3>
      <p class="mt-2.5 text-muted-foreground">
        An archived animal never counts against your cap. A rehabilitation centre with four hundred
        intakes a year and thirty patients today is a thirty-animal facility. We are not going to
        build a product that gives you a reason to leave an animal out of the record.
      </p>
    </div>

    <div class="reveal rounded-2xl border border-border bg-card p-7">
      <h3 class="text-lg">The trial, and what happens after it</h3>
      <p class="mt-2.5 text-muted-foreground">
        Every new organization gets thirty days with Pro features and trial-sized storage. If the
        trial lapses and nothing is chosen, the organization goes read-only: new capture stops, and
        reading, searching, printing and exporting everything already recorded carries on
        indefinitely.
      </p>
    </div>
  </div>
</Section>
