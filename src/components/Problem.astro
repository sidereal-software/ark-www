---
import Section from "./Section.astro";
import Footnote from "./Footnote.astro";

/*
 * This section used to carry a citation on every step of the chain and a
 * full-height pull-quote panel with two more. It was doing the work of a
 * literature review to establish something the reader either recognises from
 * their own week or does not.
 *
 * The steps below are a plain description of ordinary practice, not contested
 * factual claims, so they no longer cite anything. One source remains, on the
 * one statement here that is genuinely a finding rather than an observation:
 * that the recopying loses data. That is worth citing precisely because a
 * reader could reasonably doubt it.
 */
const chain = [
  {
    step: "At the enclosure",
    body: "A whiteboard, a clipboard or a paper log - whatever is closest to the animal at the moment somebody notices something.",
  },
  {
    step: "Later that day",
    body: "Someone types it up, from the board or from memory, into the system that holds the permanent record.",
  },
  {
    step: "Then again",
    body: "A senior keeper or a registrar reviews those entries and accepts or rejects them before they are final.",
  },
  {
    step: "And once more",
    body: "At reporting time the year is transcribed again, into whatever form the permitting agency wants.",
  },
];
---

<Section
  id="problem"
  tone="ink"
  eyebrow="The problem"
  title="Everything gets written twice. Sometimes three times."
  lead="The place the observation happens and the place the record lives are two different places, and the gap between them is bridged by hand."
>
  <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-16">
    <ol class="reveal space-y-0">
      {
        chain.map((link, i) => (
          <li class="relative pb-8 pl-10 last:pb-0">
            {i < chain.length - 1 && (
              <span
                class="absolute top-8 bottom-0 left-[0.6875rem] w-px bg-ink-border"
                aria-hidden="true"
              />
            )}
            <span
              class="absolute top-1 left-0 flex size-6 items-center justify-center rounded-full border border-ink-border bg-ink text-[0.7rem] font-semibold text-ink-primary"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <p class="font-display text-lg font-semibold">{link.step}</p>
            <p class="mt-1.5 text-ink-muted">{link.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal">
      <div class="space-y-5 text-ink-muted">
        <p class="font-display text-xl leading-snug text-balance text-ink-foreground sm:text-2xl">
          Every one of those steps is a chance to lose something.
        </p>
        <p>
          A study of 58,185 wildlife rehabilitation cases in New York State found that the
          handwritten logs behind them had to be transcribed by hand into spreadsheets, and that
          errors and inconsistencies occurred both within and between centres - misidentified
          species, missing causes of distress, missing final dispositions. Incomplete records had to
          be discarded before the rest could be analysed at all.<Footnote id="hanson" />
        </p>
        <p>
          None of that is anyone's fault. It is what copying by hand does, and it is what happens
          when the record is written somewhere other than where the work is.
        </p>
      </div>
    </div>
  </div>
</Section>
