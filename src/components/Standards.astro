---
import Section from "./Section.astro";
import Footnote from "./Footnote.astro";

const cards = [
  {
    title: "Entered the same day",
    body: "AZA's standards expect daily records entered the same day, or by the end of the next working day. An entry made at the moment of the observation is already inside that window.",
    cite: "aza",
  },
  {
    // The annual inventory, transfer form and care sheet are the Pro-tier
    // compliance pack (see src/data/records.ts, "Compliance documents", and
    // the Pro column in src/data/pricing.ts). This card previously described
    // them without saying so, which read as though every plan produced them.
    // If a capability is tiered anywhere on the page it has to be tiered
    // everywhere on the page.
    title: "Produced on demand",
    body: "The annual inventory, the transfer form and the care sheet are generated from the records you already keep, on the day someone asks for them. These are on the Pro plan; downloading your animals and logs as a spreadsheet is on every plan.",
  },
  {
    title: "Able to show their own history",
    body: "When an inspector asks who recorded something and when, the answer is in the record - including what it said before anyone changed it, and what happened to entries somebody removed.",
  },
];
---

{
  /* The lead is written here rather than passed to <Section lead="...">
    because it carries a citation. As a prop it is a plain string, so the
    marker had to go in a block of its own underneath - which rendered as a
    lone superscript "2" floating under the paragraph with nothing attached
    to it. A footnote marker has to sit against the sentence it cites. */
}
<Section
  id="standards"
  eyebrow="Standards and compliance"
  title="What the accrediting bodies require."
>
  <p class="reveal mt-5 max-w-3xl text-lg text-pretty text-muted-foreground">
    AZA, the Zoological Association of America and the Global Federation of Animal Sanctuaries each
    require an accredited member to keep an animal records system. None of them requires a
    particular vendor. What they want is that the records exist, that they are current, and that you
    can produce them.<Footnote id="standards-bodies" />
  </p>

  <div class="mt-12 grid gap-5 md:grid-cols-3">
    {
      cards.map((card) => (
        <article class="reveal rounded-2xl border border-border bg-card p-7 shadow-sm">
          <h3 class="text-xl text-balance">{card.title}</h3>
          <p class="mt-3 text-muted-foreground">
            {card.body}
            {card.cite && <Footnote id={card.cite} />}
          </p>
        </article>
      ))
    }
  </div>

  <div
    class="reveal mt-8 rounded-2xl border border-border border-l-4 border-l-primary bg-card p-7 sm:p-9"
  >
    <h3 class="text-xl">Two things that depend on which rules bind you</h3>

    <div class="mt-5 grid gap-8 md:grid-cols-2">
      <div>
        <p class="font-semibold">How long you have to keep it</p>
        <p class="mt-2 text-muted-foreground">
          Licensed exhibitors under the Animal Welfare Act keep records for one year after an animal
          is disposed of or dies, longer where other law applies. Federal migratory bird
          rehabilitation permits require five years. State schedules differ again.<Footnote
            id="retention"
          /> ARK never deletes on a schedule of its own, so the retention question stays yours to answer
          against the rules that actually bind you.
        </p>
      </div>

      <div>
        <p class="font-semibold">When your annual report is due</p>
        <p class="mt-2 text-muted-foreground">
          California, Washington and New York each have their own form and their own deadline, and
          they do not agree with each other.<Footnote id="reporting" /> ARK holds the underlying data,
          dated, attributable and exportable, whichever form you have to fill in.
        </p>
      </div>
    </div>
  </div>
</Section>
