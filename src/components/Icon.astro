---
import { ArrowRight, Check, Moon, Sun, X } from "lucide-react";

/**
 * Every icon on a prerendered page, from lucide.
 *
 * These are the real lucide components, rendered on the server. Astro runs the
 * React renderer at build time and emits plain SVG - the probe that settled
 * this produced lucide's own markup with no `astro-island` wrapper and not one
 * byte of client JavaScript. So the rule the old version of this file claimed
 * still holds, and now it is true of actual lucide rather than of a hand-drawn
 * approximation of it: an icon on a static page has no reason to arrive as
 * JavaScript.
 *
 * What was here before was five hand-drawn glyphs - a tick, a cross and an
 * arrow in this file, a sun and a moon inside ThemeToggle - all of them
 * eyeballed to look roughly like lucide while the hydrated menu imported the
 * genuine article. Two icon vocabularies, one of them invented. Nothing on the
 * site is hand-drawn now.
 *
 * Adding one: import it here and add it to the map. Do not inline path data.
 */
const GLYPHS = {
  check: Check,
  cross: X,
  "arrow-right": ArrowRight,
  sun: Sun,
  moon: Moon,
} as const;

export type IconName = keyof typeof GLYPHS;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;
const Glyph = GLYPHS[name];
---

{
  /* `className`, not `class`. Astro hands props to a framework component
    untranslated, so `class` would be dropped on the floor and every icon would
    render at lucide's default 24px. lucide merges what it is given with its own
    `lucide lucide-<name>` classes rather than replacing them. */
}
<Glyph className={className} />
