---
import { ICONS, ICON_VIEWBOX, type IconName } from "../data/icons";

/**
 * Every icon on a prerendered page, from game-icons.net.
 *
 * The set and the licence live in src/data/icons.ts; this only draws them. It
 * ships as inline markup with no runtime behind it, which is the rule that has
 * not changed: an icon on a static page has no reason to arrive as JavaScript.
 * The React island uses <GameIcon> instead, and both read from the same data,
 * so the two surfaces cannot drift onto different glyphs.
 */
interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;
const icon = ICONS[name];
---

{
  /* No stroke. These are filled shapes rather than stroked outlines, which is
    the whole difference in weight between this set and the line icons it
    replaced. */
}
<svg viewBox={ICON_VIEWBOX} fill="currentColor" class={className} aria-hidden="true">
  <path d={icon.path} transform={icon.transform}></path>
</svg>
