---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { NEVER } from "../data/never";
---

<Section
  id="never"
  eyebrow="Commitments"
  title="What ARK will never do."
  lead="A features list tells you what a company is selling today. Every line here is enforced by how the product is built, not by a policy page."
>
  <ul class="mt-14 grid gap-5 lg:grid-cols-2">
    {
      NEVER.map((item) => (
        <li class="reveal rounded-2xl border border-border bg-card p-7 shadow-sm sm:p-8">
          <div class="flex items-start gap-4">
            <span
              class="mt-1 flex size-7 shrink-0 items-center justify-center rounded-full border border-border text-muted-foreground"
              aria-hidden="true"
            >
              <Icon name="cross" class="size-3.5" />
            </span>
            <div>
              <h3 class="text-xl text-balance">{item.never}</h3>
              <p class="mt-3 text-muted-foreground">{item.because}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
