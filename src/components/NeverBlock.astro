---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { NEVER } from "../data/never";
---

<Section id="never" eyebrow="Commitments" title="What ARK will never do.">
  <ul class="mt-14 grid gap-5 lg:grid-cols-2">
    {
      NEVER.map((item) => (
        <li class="reveal rounded-2xl border border-border bg-card p-7 shadow-sm sm:p-8">
          <div class="flex items-start gap-4">
            {/* No ring around this one. The old glyph was a bare X and needed
                a drawn circle to read as a token; game-icons' `cancel` is
                already a crossed circle, and keeping the wrapper gave every
                item a ring inside a ring. The icon is the whole mark now. */}
            <Icon name="cross" class="mt-1 size-6 shrink-0 text-muted-foreground" />
            <div>
              <h3 class="text-xl text-balance">{item.never}</h3>
              <p class="mt-3 text-muted-foreground">{item.because}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
