---
import { CONTACT_HREF, SITE } from "../consts";
import Icon from "./Icon.astro";

// Leaf, from Hero Patterns by Steve Schoger, CC BY 4.0. The credit is in the
// footer, which is where a licence that asks for attribution has to be paid.
// https://heropatterns.com
//
// It replaces a generated field of contour hairlines. Those were drawn to look
// like a survey map and mostly read as a technical drawing - the thing this
// site has spent a while getting away from. Foliage is the right register for
// the subject in daylight, and it earns its keep twice over at night, where
// leaves in phosphor green are exactly what the palette is quoting.
//
// The path is upstream's, unchanged. It tiles an 80x40 cell; drawn at that
// size it is busy enough to read as texture-on-purpose rather than as ground,
// so the <pattern> is scaled up and the whole field kept very faint.
const LEAF_PATH =
  "M0 40a19.96 19.96 0 0 1 5.9-14.11 20.17 20.17 0 0 1 19.44-5.2A20 20 0 0 1 20.2 40H0zM65.32.75A20.02 20.02 0 0 1 40.8 25.26 20.02 20.02 0 0 1 65.32.76zM.07 0h20.1l-.08.07A20.02 20.02 0 0 1 .75 5.25 20.08 20.08 0 0 1 .07 0zm1.94 40h2.53l4.26-4.24v-9.78A17.96 17.96 0 0 0 2 40zm5.38 0h9.8a17.98 17.98 0 0 0 6.67-16.42L7.4 40zm3.43-15.42v9.17l11.62-11.59c-3.97-.5-8.08.3-11.62 2.42zm32.86-.78A18 18 0 0 0 63.85 3.63L43.68 23.8zm7.2-19.17v9.15L62.43 2.22c-3.96-.5-8.05.3-11.57 2.4zm-3.49 2.72c-4.1 4.1-5.81 9.69-5.13 15.03l6.61-6.6V6.02c-.51.41-1 .85-1.48 1.33zM17.18 0H7.42L3.64 3.78A18 18 0 0 0 17.18 0zM2.08 0c-.01.8.04 1.58.14 2.37L4.59 0H2.07z";

const facts = [
  "Unlimited users on every plan",
  "30-day free trial, Pro features",
  "Download your records any time",
];
---

<section
  class="relative isolate overflow-hidden px-5 pt-16 pb-20 sm:px-8 sm:pt-24 lg:pt-28 lg:pb-28"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    {
      /* A <pattern> rather than a repeating background-image, so the leaves can
        be painted in `currentColor` and follow the theme. A data-URI background
        would have the fill baked into the string and need a second copy for
        night. */
    }
    <svg class="leaf-field h-full w-full text-primary">
      <defs>
        <pattern id="leaf-tile" width="160" height="80" patternUnits="userSpaceOnUse">
          <path d={LEAF_PATH} fill="currentColor" transform="scale(2)"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#leaf-tile)"></rect>
    </svg>
    {
      /* The wash sits over the leaves and fades them out towards the copy, so
        the pattern is densest in the corner nobody reads. */
    }
    {
      /* Sized in percentages, not rem. At a fixed 70rem radius the clear
        centre was wider than a phone, so the wash never actually reached the
        copy and the leaves stayed at full strength behind the headline. A
        percentage radius is measured against the hero, so the fade lands in
        the same place at 390px as it does at 1440px. */
    }
    <div
      class="absolute inset-0 bg-[radial-gradient(115%_85%_at_88%_-12%,transparent,var(--background)_68%)]"
    >
    </div>
  </div>

  {
    /* SCREENSHOT SEAM - the capture sheet, mid-flow, on a phone.
      A category chosen, a real sentence in the note field, the photo attached,
      Save primed. It belongs to the right of this column; restore the grid
      when it lands:
        <div class="mx-auto grid max-w-6xl items-center gap-14
                    lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-20">
      and put the <Image> in a second child div. Capture brief in
      SCREENSHOTS.md.

      Until then the hero is a single column with the measure capped, rather
      than a wide column with a hole beside it. */
  }
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p class="hero-in eyebrow">
        Zoos &middot; Rehabilitation &middot; Sanctuaries &middot; Rescues
      </p>

      {
        /* The motto is the heading, so the heading no longer says what ARK is.
          The line below has to, and it carries the category words the <h1>
          gave up - see the note on SITE.tagline in src/consts.ts for how that
          trade is split between the two. */
      }
      <h1
        class="hero-in hero-in-delay-1 mt-5 text-[clamp(2.6rem,7vw,4.75rem)] leading-[1.02] font-semibold text-balance"
      >
        {SITE.motto}
      </h1>

      <p
        class="hero-in hero-in-delay-2 mt-6 max-w-xl text-lg text-pretty text-muted-foreground sm:text-xl"
      >
        Animal recordkeeping for zoos, sanctuaries, rescues and rehabilitation centres. Log what you
        saw standing at the enclosure, on a phone, online or off - and nobody types it up again.
      </p>

      {
        /* Full-width buttons below sm: at 320px "Talk to us about your facility"
          wraps, and a wrapped label inside a shrink-wrapped button leaves the
          arrow stranded against the right edge. */
      }
      <div class="hero-in hero-in-delay-3 mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={CONTACT_HREF}
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-center font-semibold text-primary-foreground shadow-md transition-[transform,box-shadow] hover:shadow-lg active:translate-y-px"
        >
          Talk to us about your facility
          <Icon name="arrow-right" class="size-4 shrink-0" />
        </a>
        <a
          href="#how"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-card px-6 py-3.5 text-center font-semibold text-foreground shadow-sm transition-colors hover:bg-muted"
        >
          See how it works
        </a>
      </div>

      {
        /* Two columns rather than a wrapping row: wrapped, the labels break at
          whatever width the viewport happens to be, and a fact split across two
          lines reads as two facts. */
      }
      <ul
        class="hero-in hero-in-delay-3 mt-9 grid max-w-xl gap-x-6 gap-y-2.5 text-sm text-muted-foreground sm:grid-cols-2"
      >
        {
          facts.map((fact) => (
            <li class="flex items-center gap-2">
              <Icon name="check" class="size-4 shrink-0 text-primary" />
              {fact}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Two opacities, because the same value does not read the same on both
     grounds: solid shapes on cream want to be nearly invisible, and the same
     ink on a dark ground disappears entirely. Night gets more, not less. */
  .leaf-field {
    opacity: 0.05;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .leaf-field {
      opacity: 0.11;
    }
  }

  :root[data-theme="dark"] .leaf-field {
    opacity: 0.11;
  }
</style>
