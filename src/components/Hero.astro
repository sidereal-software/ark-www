---
import { CONTACT_HREF } from "../consts";
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";

// Contour lines, the way a survey map or a field guide's terrain inset draws
// them. This is the site's one piece of decoration and it is generated rather
// than drawn, so it stays regular.
//
// They fall down the page rather than across it. Drawn across, a hairline that
// happens to pass under a line of body copy reads as an underline - the web's
// one universal link signifier - and where it lands is decided by the line
// wrap, so it appears and disappears with the viewport. Every stroke below
// stays within about 22 degrees of vertical, which no amount of reflow can
// turn into an underline. Steepness is a property of the path data: the y
// coordinates advance monotonically and far faster than the x coordinates
// wander, and `slice` scales uniformly, so the angles survive to the screen.
const contours = Array.from({ length: 10 }, (_, i) => {
  const x = -60 + i * 110;
  return `M${x} -80 C ${x + 48} 190, ${x - 52} 380, ${x + 20} 560 S ${x - 44} 840, ${x + 12} 1000`;
});

const facts = [
  "Unlimited users on every plan",
  "30-day free trial, Pro features",
  "Export your data on any plan",
];
---

{
  /* The section itself carries no horizontal padding above lg, because the
    photograph has to reach the right edge of the viewport. Padding is pushed
    onto the text column instead, where `pl` reproduces the gutter the header
    and every Section below use: half the difference between the viewport and
    the 72rem content column, never less than the 2rem side margin. That keeps
    the eyebrow left-aligned with the logo above it and the section headings
    below it, which a plain 50/50 split would not. */
}
<section class="relative isolate overflow-hidden pt-16 pb-20 sm:pt-24 lg:pt-0 lg:pb-0">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <svg
      viewBox="0 0 920 920"
      preserveAspectRatio="xMidYMid slice"
      class="h-full w-full text-primary opacity-[0.075]"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
    >
      {contours.map((d) => <path d={d} />)}
    </svg>
    <div
      class="absolute inset-0 bg-[radial-gradient(60rem_32rem_at_18%_-10%,color-mix(in_oklab,var(--accent)_38%,transparent),transparent)]"
    >
    </div>
  </div>

  <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-0">
    <div
      class="mx-auto w-full max-w-6xl px-5 sm:px-8 lg:mx-0 lg:max-w-none lg:py-28 lg:pr-14 lg:pl-[max(2rem,calc((100vw-72rem)/2))]"
    >
      <p class="hero-in eyebrow">
        Zoos &middot; Rehabilitation &middot; Sanctuaries &middot; Rescues
      </p>

      <h1
        class="hero-in hero-in-delay-1 mt-5 text-[clamp(2.35rem,6.2vw,4.25rem)] leading-[1.04] font-semibold text-balance"
      >
        Animal records that get written at the enclosure.
      </h1>

      <p
        class="hero-in hero-in-delay-2 mt-6 max-w-xl text-lg text-pretty text-muted-foreground sm:text-xl"
      >
        A keeper finds the animal, taps a category, adds a note and a photo, and saves it to the
        permanent record. About thirty seconds on a phone.
      </p>

      {
        /* Full-width buttons below sm: at 320px "Talk to us about your facility"
          wraps, and a wrapped label inside a shrink-wrapped button leaves the
          arrow stranded against the right edge. */
      }
      <div class="hero-in hero-in-delay-3 mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={CONTACT_HREF}
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-center font-semibold text-primary-foreground shadow-md transition-[transform,box-shadow] hover:shadow-lg active:translate-y-px"
        >
          Talk to us about your facility
          <Icon name="arrow-right" class="size-4 shrink-0" />
        </a>
        <a
          href="#how"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-card px-6 py-3.5 text-center font-semibold text-foreground shadow-sm transition-colors hover:bg-muted"
        >
          See how it works
        </a>
      </div>

      {
        /* Two columns rather than a wrapping row: wrapped, the labels break at
          whatever width the viewport happens to be, and a fact split across two
          lines reads as two facts. */
      }
      <ul
        class="hero-in hero-in-delay-3 mt-9 grid max-w-xl gap-x-6 gap-y-2.5 text-sm text-muted-foreground sm:grid-cols-2"
      >
        {
          facts.map((fact) => (
            <li class="flex items-center gap-2">
              <Icon name="check" class="size-4 shrink-0 text-primary" />
              {fact}
            </li>
          ))
        }
      </ul>
    </div>

    {
      /* The photograph is the argument, so it is not an illustration beside the
        headline - it is the other half of the spread. A bander holds a warbler
        in one hand over a ring binder of paper record sheets, pencil across the
        columns. That is the job this product is for, and it is the paper ARK
        replaces, in one frame.

        It bleeds off the right and the top on large screens the way a plate is
        tipped into a page, rather than sitting in a rounded card - a card would
        make it a screenshot of a photograph. Below lg it becomes a full-width
        band above the text, which is the arrangement every zoo and rehab site
        uses on a phone. */
    }
    <div class="hero-in hero-in-delay-3 order-first px-5 sm:px-8 lg:order-none lg:h-full lg:px-0">
      <Photo
        slug="banding-record-sheet"
        eager
        position="46% 62%"
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="aspect-[4/3] w-full rounded-2xl sm:aspect-[16/10] lg:aspect-auto lg:h-full lg:min-h-[40rem] lg:rounded-none"
      />
    </div>
  </div>
</section>
